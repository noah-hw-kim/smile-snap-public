# ── Database ───────────────────────────────────────────────────────────────────
# Neon Postgres pooled connection string (copy with Connection pooling ON)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require"

# ── AWS S3 Storage ─────────────────────────────────────────────────────────────
# Name of your S3 bucket (created in AWS Console)
S3_BUCKET_NAME="your-s3-bucket-name"

# ── Firebase Auth ──────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → General → Your apps → Web API key
FIREBASE_WEB_API_KEY="AIzaSy..."

# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE contents of the downloaded JSON as a single-line string:
# python3 -c "import json; f=open('serviceAccountKey.json'); print(json.dumps(json.load(f)))"
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n..."}'

# ── External APIs ──────────────────────────────────────────────────────────────
# https://ai.google.dev/
GEMINI_API_KEY="your_gemini_api_key"

# Optional enrichment (leave blank to skip geolocation / weather lookup)
# https://ipinfo.io/account/token
IPINFO_API_TOKEN=""

# https://openweathermap.org/api/keys
WEATHER_API_KEY=""

# ── App ────────────────────────────────────────────────────────────────────────
# "development" enables public IP fallback for local IP testing
ENVIRONMENT="development"

# ── Redis (Optional) ───────────────────────────────────────────────────────────
# Leave blank to disable caching and rate limiting (app degrades gracefully).
# Local Docker: redis://localhost:6379
# Upstash TLS:  rediss://default:<password>@<host>:6379
REDIS_URL=""
GENERATE_RATE_LIMIT="10"
GENERATE_RATE_WINDOW_SECONDS="3600"