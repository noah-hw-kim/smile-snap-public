# ── Database ───────────────────────────────────────────────────────────────────
MONGO_DETAILS="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>"

# ── AWS S3 Storage ─────────────────────────────────────────────────────────────
# Name of your S3 bucket (created in AWS Console)
S3_BUCKET_NAME="your-s3-bucket-name"

# ── Firebase Auth ──────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → General → Your apps → Web API key
FIREBASE_WEB_API_KEY="AIzaSy..."

# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE contents of the downloaded JSON as a single-line string:
# python3 -c "import json; f=open('serviceAccountKey.json'); print(json.dumps(json.load(f)))"
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n..."}'

# ── External APIs ──────────────────────────────────────────────────────────────
# https://ai.google.dev/
GEMINI_API_KEY="your_gemini_api_key"

# https://ipinfo.io/account/token
IPINFO_API_TOKEN="your_ipinfo_api_token"

# https://openweathermap.org/api/keys
WEATHER_API_KEY="your_openweathermap_api_key"

# ── App ────────────────────────────────────────────────────────────────────────
# "development" enables public IP fallback for local IP testing
ENVIRONMENT="development"